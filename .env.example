# UPI Sentinel Environment Configuration
PORT=5000
NODE_ENV=development

# AI Provider Configuration (Options: 'gemini', 'openai', 'mock')
# When set to 'mock' or if API keys are empty, UPI Sentinel runs in offline heuristic Demo mode
AI_PROVIDER=mock

# Google Gemini API Key (Required only if AI_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Required only if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Model Override (Default: gemini-2.5-flash or gpt-4o-mini)
AI_MODEL=gemini-2.5-flash
